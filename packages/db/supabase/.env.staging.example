# Supabase config push — STAGING (copy to .env.staging and fill in)
# Consumed by scripts/push-config.sh; interpolated into config.toml via env().
PROJECT_REF=<staging-project-ref>

SUPABASE_AUTH_SITE_URL=https://<staging-web-host>
SUPABASE_AUTH_WEB_URL_WILDCARD=https://<staging-web-host>/**
SUPABASE_AUTH_WEB_URL_CALLBACK=https://<staging-web-host>/auth/callback
