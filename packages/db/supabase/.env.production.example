# Supabase config push — PRODUCTION (copy to .env.production and fill in)
# Consumed by scripts/push-config.sh; interpolated into config.toml via env().
# OFF-LIMITS by default — push script requires typing the ref to confirm.
PROJECT_REF=<production-project-ref>

SUPABASE_AUTH_SITE_URL=https://<production-web-host>
SUPABASE_AUTH_WEB_URL_WILDCARD=https://<production-web-host>/**
SUPABASE_AUTH_WEB_URL_CALLBACK=https://<production-web-host>/auth/callback
