# App URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Worker mode (internal routes + in-process schedulers)
# WORKER_ENABLED=true runs the worker: /api/internal routes (reminders/tick,
# google-calendar/sync, notify-manager, approve/reject) + in-process schedulers
# (reminders every 5 min, Google Calendar sync every 15 min).
# The `pnpm dev` script sets this automatically for local one-unit development.
# In production, set it on the worker Railway service only — the public API
# service leaves it unset.
# Shared secret required by all /api/internal/* routes (header X-Internal-Secret).
INTERNAL_SECRET=changeme

# WhatsApp Cloud API
# Each tenant registers their own Meta App — phone_number_id, access_token,
# app_secret, and verify_token all live encrypted in whatsapp_credentials
# (see docs), not here. Webhook URL per tenant: /api/webhooks/whatsapp/:businessId
#
# Master key used to encrypt/decrypt those per-tenant secrets at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=<32-byte base64>
# Set to "true" only after the "manager_new_booking" template is approved in
# WhatsApp Manager. Until then, manager notifications use a free-form interactive
# message, which Meta silently drops (error 131047) once 24h pass without the
# manager messaging the bot. Template messages are exempt from that window.
WHATSAPP_MANAGER_TEMPLATE_APPROVED=false

# Google Calendar integration
# OAuth 2.0 credentials from Google Cloud Console. Create them under
# APIs & Services > Credentials > OAuth 2.0 Client ID (Web application).
# GOOGLE_REDIRECT_URI should point to the frontend page that receives the code.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/he/dashboard/settings
